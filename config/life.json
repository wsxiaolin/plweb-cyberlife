      8,
      10,
      12,
      14,
      16,
      18,
      20,
      22
    ],
    "hard_sleep_hours": [
      0,
      6
    ],
    "max_session_minutes": 50,
    "$comment2": "hard_sleep_hours 内不做任何对外发言（除非运营者手动唤醒）。max_session_minutes：一段\"在线\"的总时长——含挂机等消息，不是干完活就走"
  },
  "wake_slots": {
    "$comment": "作息门卫的唤醒时刻表（北京时间 HH:MM）。上学日只开 school 槽（3 醒），自由日只开 free 槽（8 醒，08:30~22:30 每 2 小时一槽）；改动这里必须同步 .github/workflows/wakeup.yml 的 cron。",
    "school": [
      "06:55",
      "12:40",
      "22:05"
    ],
    "free": [
      "08:30",
      "10:30",
      "12:30",
      "14:30",
      "16:30",
      "18:30",
      "20:30",
      "22:30"
    ]
  },
  "budget": {
    "daily_comment_max": 5,
    "daily_reply_max": 8,
    "weekly_discussion_post_max": 2,
    "daily_follow_max": 2,
    "daily_message_max": 3,
    "publish_experiment_interval_days": 10,
    "message_reply_probability": {
      "$comment": "收到消息的回复倾向（可被熟人/陌生人上下文调整）",
      "close_friend": 0.95,
      "acquaintance": 0.8,
      "stranger": 0.45
    }
  },
